          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "unknown 은 «만들어졌을 수도 있다» — 실패로 읽지 않는다."
