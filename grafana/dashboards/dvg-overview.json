{
  "uid": "dvg-overview",
  "title": "DVG · 개요",
  "description": "게이트웨이 버전 · 가동 시간 · 세션 수",
  "tags": [
    "dvg"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "테넌트",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dvg-prometheus"
        },
        "query": {
          "query": "label_values(dvg_gateway_sessions, tenant)",
          "refId": "v"
        },
        "definition": "label_values(dvg_gateway_sessions, tenant)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "게이트웨이 버전",
      "datasource": {
        "type": "prometheus",
        "uid": "dvg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dvg_build_info",
          "legendFormat": "{{version}}",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^version$/"
        },
        "textMode": "name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "가동 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "dvg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - dvg_process_start_time_seconds",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "카운터는 이때부터 센다 — 재시작하면 0 에서 다시 센다."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "지금 다루는 세션",
      "datasource": {
        "type": "prometheus",
        "uid": "dvg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dvg_gateway_sessions{tenant=~\"$tenant\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "DVG 를 거치는 통화만이다(PBX 의 모든 통화가 아니다)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "진행 중 앱 통화",
      "datasource": {
        "type": "prometheus",
        "uid": "dvg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dvg_app_live_calls{tenant=~\"$tenant\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "세션 수(테넌트별)",
      "datasource": {
        "type": "prometheus",
        "uid": "dvg-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (dvg_gateway_sessions{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}}",
          "datasource": {
            "type": "prometheus",
            "uid": "dvg-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
